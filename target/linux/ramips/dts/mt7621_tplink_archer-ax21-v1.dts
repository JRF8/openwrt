/dts-v1/;

#include "mt7621.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>

/ {
	compatible = "tplink,archer-ax21-v1", "mediatek,mt7621-soc";
	model = "TP-Link Archer AX21 v1";

	aliases {
		led-boot = &led_power;
		led-failsafe = &led_power;
		led-running = &led_power;
		led-upgrade = &led_power;
	};

	chosen {
		bootargs = "console=ttyS0,115200";
	};

	leds {
		compatible = "gpio-leds";

		led_power: power {
			label = "green:power";
			gpios = <&gpio 18 GPIO_ACTIVE_LOW>;
		};

		led_2g: 2g {
			label = "green:2g";
			gpios = <&gpio 16 GPIO_ACTIVE_LOW>;
		};

		led_5g: 5g {
			label = "green:5g";
			gpios = <&gpio 15 GPIO_ACTIVE_LOW>;
		};

		internet_green {
			label = "green:internet";
			gpios = <&gpio 14 GPIO_ACTIVE_LOW>;
		};

		internet_orange {
			label = "orange:internet";
			gpios = <&gpio 13 GPIO_ACTIVE_LOW>;
		};

		lan {
			label = "green:lan";
			gpios = <&gpio 4 GPIO_ACTIVE_LOW>;
		};

		wps {
			label = "green:wps";
			gpios = <&gpio 3 GPIO_ACTIVE_LOW>;
		};
	};

	keys {
		compatible = "gpio-keys";

		reset {
			label = "reset";
			gpios = <&gpio 8 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
		};

		wifi {
			label = "wifi";
			gpios = <&gpio 7 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_WPS_BUTTON>;
		};
	};
};

&spi0 {
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <50000000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "u-boot";
				reg = <0x0 0x40000>;
				read-only;
			};

			firmware: partition@40000 {
				compatible = "tplink,firmware";
				label = "firmware";
				reg = <0x40000 0xf60000>;
			};

			partition@fa0000 {
				label = "extra-para";
				reg = <0xfa0000 0x10000>;
				read-only;
			};

			partition@fb0000 {
				label = "default-config";
				reg = <0xfb0000 0x10000>;
				read-only;
			};

			partition@fc0000 {
				label = "user-config";
				reg = <0xfc0000, 0x10000>;
				read-only;
			};

			partition@fd0000 {
				label = "ag-config";
				reg = <0xfd0000, 0x10000>;
				read-only;
			};

			partition@fe0000 {
				label = "partition-table";
				reg = <0xfe0000, 0x10000>;
				read-only;
			};

			radio: partition@ff0000 {
				label = "radio";
				reg = <0xff0000 0x10000>;
				read-only;
			};
		};
	};
};

&gmac0 {
	status = "okay";
};

&gmac1 {
	status = "okay";
};

&pcie {
	status = "okay";
};

&pcie0 {
	wifi@0,0 {
		compatible = "mediatek,mt76";
		reg = <0x0000 0 0 0 0>;
		mediatek,mtd-eeprom = <&radio 0x0>;
		ieee80211-freq-limit = <2400000 2483500>;
	};
};

&pcie1 {
	wifi@0,0 {
		compatible = "mediatek,mt76";
		reg = <0x0000 0 0 0 0>;
		mediatek,mtd-eeprom = <&radio 0x8000>;
		ieee80211-freq-limit = <5150000 5875000>;
	};
};

&gsw {
	mediatek,portmap = "wllll";
};